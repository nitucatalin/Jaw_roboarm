<?xml version="1.0"?>
<robot name="my_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:arg name="initial_positions_file" default="$(find my_robot_description)/config/initial_positions.yaml"/>
    <xacro:include filename="$(find my_robot_description)/urdf/mobile_base.xacro" />
    <xacro:include filename="$(find my_robot_description)/urdf/my_robot.ros2_control.xacro" />
    <xacro:my_robot_ros2_control name="ArmSystem" initial_positions_file="$(arg initial_positions_file)"/>
</robot>