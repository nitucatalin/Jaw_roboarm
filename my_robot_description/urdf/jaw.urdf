  <link name="base_link">
    <visual>
      <origin rpy="1.5708 0 0" xyz="-0.52 0.8 0"/>
      <geometry><mesh filename="package://my_robot_description/meshes/baza.STL" scale="0.01 0.01 0.01"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
