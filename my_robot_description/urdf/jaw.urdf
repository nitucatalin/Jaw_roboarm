      <geometry><mesh filename="package://my_robot_description/meshes/baza.STL" scale="0.01 0.01 0.01"/></geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="-0.52 0.8 0"/><mass value="0.02"/>
      <inertia ixx="0.000104" ixy="0.0" ixz="0.0" iyy="0.000104" iyz="0.0" izz="0.000208"/>
