<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <material name="blue">
        <color rgba="0.2 0.2 0.8 1"/>
    </material>

    <!-- Inertial computed from the link's mesh (uniform density):
         xyz          = centre of mass in the link frame [m]
         ixx ... iyz  = inertia about the centre of mass, PER KILOGRAM, in link axes [m^2]
         mass         = kg; the tensor is multiplied by it, so changing the mass keeps the geometry right -->
    <xacro:macro name="mesh_inertial" params="mass xyz ixx iyy izz ixy ixz iyz">
        <inertial>
            <origin xyz="${xyz}" rpy="0 0 0"/>
            <mass value="${mass}"/>
            <inertia ixx="${mass * ixx}" iyy="${mass * iyy}" izz="${mass * izz}"
                     ixy="${mass * ixy}" ixz="${mass * ixz}" iyz="${mass * iyz}"/>
        </inertial>
    </xacro:macro>

</robot>
